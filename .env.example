# Copy this file to .env and fill in your credentials.

# Spaceship public API (https://docs.spaceship.dev) — used by the hyperlift skill.
# The key and secret are a pair: BOTH are required; either one alone gets HTTP 401.
# Create an API key in the Spaceship API manager with the scopes you need:
#   hyperlift:read (inspect, logs, metrics), hyperlift:execute (build, restart,
#   start/stop), hyperlift:manage (read/write environment variables).
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# Note: the optional SPACESHIP_API_BASE_URL override is read from the real
# environment only (export it in your shell) — it is deliberately ignored in
# .env files so a checked-in .env cannot redirect credentials to another host.
